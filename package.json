{
  "name": "toolmenu",
  "version": "0.28.0",
  "mcpName": "io.github.niksa90/toolmenu",
  "description": "Test your MCP server the way agents and clients meet it: the menu, the calls, the results, the sign-in, and every release after. No LLM involved.",
  "author": "Nikša Perović (https://niksa.me)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/rule-docs.mjs",
    "test": "npm run build && node --test --test-reporter=spec test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niksa90/toolmenu.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "interoperability",
    "conformance",
    "agents",
    "prompt-caching",
    "cli",
    "mcp-server"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/niksa90/toolmenu/issues"
  },
  "homepage": "https://github.com/niksa90/toolmenu#readme",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-tiktoken": "^1.0.21",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "toolmenu": "dist/cli.js"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  }
}
