    {
      "name": "get_index_advisor_recommendations",
      "description": "Get index recommendations from Couchbase Index Advisor for a given SQL++ query.\n\nThe Index Advisor analyzes the query and provides recommendations for optimal indexes.\nThis tool works with SELECT, UPDATE, DELETE, or MERGE queries.\nThe queries will be run on the specified scope in the specified bucket.\n\nReturns a dictionary with:\n- current_used_indexes: Array of currently used indexes (if any)\n- recommended_indexes: Array of recommended secondary indexes (if any)\n- recommended_covering_indexes: Array of recommended covering indexes (if any)\n\nEach index object contains:\n- index: The CREATE INDEX SQL++ command\n- statements: Array of statement objects with the query and run count",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bucket_name": {
            "type": "string"
          },
          "scope_name": {
            "type": "string"
          },
          "query": {
            "type": "string"
          }
        },
        "required": [
