    {
      "name": "run_sql_plus_plus_query",
      "description": "Run a SQL++ query on a scope and return the results as a list of JSON objects.\n\nThe query will be run on the specified scope in the specified bucket.\nThe query should use collection names directly without bucket/scope prefixes, as the scope context is automatically set.\n\nUse ``named_parameters`` to bind values to ``$name`` placeholders in the\nquery instead of concatenating user input into the statement. This prevents\nSQL++ injection\n\nExample:\n    query = \"SELECT * FROM users WHERE age > 18\"\n    # Incorrect: \"SELECT * FROM bucket.scope.users WHERE age > 18\"",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "bucket_name": {
            "type": "string"
          },
          "scope_name": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "named_parameters": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "bucket_name",
          "scope_name",
          "query"
        ],
        "type": "object"
      },
      "outputSchema": {
